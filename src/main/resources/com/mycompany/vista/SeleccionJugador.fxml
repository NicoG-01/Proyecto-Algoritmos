<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.vista.SeleccionJugadorController">
   <stylesheets>
      <URL value="@bomberman.css" />
   </stylesheets>
   <top>
      <Label fx:id="lblTurno" styleClass="titulo" text="JUGADOR 1 ELIGE TU PERSONAJE" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="10" top="20" />
         </BorderPane.margin>
      </Label>
   </top>
   <center>
      <HBox alignment="CENTER" spacing="40.0" BorderPane.alignment="CENTER">
         <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
         <children>
            <VBox alignment="CENTER" spacing="15.0">
               <ImageView fx:id="spriteP1" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
               <Button fx:id="elegrP1" maxWidth="Infinity" mnemonicParsing="false" onAction="#elegirP1" text="ELEGIR" />
            </VBox>
            <VBox alignment="CENTER" spacing="15.0">
               <ImageView fx:id="spriteP2" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
               <Button fx:id="elegrP2" maxWidth="Infinity" mnemonicParsing="false" onAction="#elegirP2" text="ELEGIR" />
            </VBox>
            <VBox alignment="CENTER" spacing="15.0">
               <ImageView fx:id="spriteP3" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
               <Button fx:id="elegrP3" maxWidth="Infinity" mnemonicParsing="false" onAction="#elegirP3" text="ELEGIR" />
            </VBox>
         </children>
      </HBox>
   </center>
   <bottom>
      <Button fx:id="btnContinuar" disable="true" maxWidth="200" mnemonicParsing="false" onAction="#continuar" text="CONTINUAR" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="20" />
         </BorderPane.margin>
      </Button>
   </bottom>
</BorderPane>
